APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./.data/collog.db
PUBLIC_BASE_URL=http://localhost:8080
JWT_SECRET=replace-with-at-least-32-random-characters

# 모델과 DB 스키마가 어긋나면 개발 DB를 재생성한다. 배포 서버는 false로 두고 스키마는
# Alembic이 소유한다. false에서는 어긋난 채로 기동하지 않고 거부한다.
SCHEMA_AUTO_RESET=true

# External calls are skipped until all provider credentials are configured.
MOCK_EXTERNAL_SERVICES=true

# Non-sensitive team integration page. Disable when the backend is internet-facing.
TEAM_PORTAL_ENABLED=true
TEAM_PORTAL_REPOSITORY_URL=https://github.com/Frekion2002/14th-hackathon

LIVEKIT_URL=ws://localhost:7880
# Backend-to-server address for a self-hosted Docker network.
LIVEKIT_INTERNAL_URL=http://livekit:7880
LIVEKIT_API_KEY=collog-dev-key
LIVEKIT_API_SECRET=collog-dev-secret-change-before-production

# iOS PushKit incoming calls. Keep disabled for foreground-only demos.
APNS_VOIP_ENABLED=false
APNS_ENVIRONMENT=sandbox
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
# Put AuthKey_*.p8 under backend/private/. Compose mounts it read-only here.
APNS_PRIVATE_KEY_PATH=/run/secrets/collog/AuthKey_XXXXXXXXXX.p8
INCOMING_CALL_TTL_SECONDS=45

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=ko

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Thinking tokens share this budget; 500 is too small for recent Flash models.
GEMINI_MAX_OUTPUT_TOKENS=2048

# Ringing question voice. ElevenLabs is generated/cache-served by the backend; the key is
# never sent to iOS. When disabled or unavailable the app falls back to iOS ko-KR TTS.
QUESTION_TTS_PROVIDER=ios_local
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
TTS_URL_TTL_SECONDS=3600

# Versioned prototype acoustic analyzer. Calibrate cough threshold with labeled fixtures.
ACOUSTIC_ANALYZER_VERSION=collog-acoustic-v3
COUGH_SCORE_THRESHOLD=0.65
QUALITY_MIN_DURATION_SEC=5.0
QUALITY_MAX_CLIPPING_RATIO=0.01
QUALITY_ACTIVE_PERCENTILE=90.0
QUALITY_MIN_ACTIVE_DBFS=-55.0
PAUSE_MIN_GAP_MS=300
PAUSE_MAX_GAP_MS=2000

# local: API uploads into .data/audio; s3: presigned upload/download and LiveKit Egress output.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=.data/audio
S3_ENDPOINT_URL=http://localhost:9000
# Device-accessible MinIO URL. Android emulator usually needs http://10.0.2.2:9000.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=ap-northeast-2
S3_BUCKET=collog-audio
S3_ACCESS_KEY_ID=collog-minio
S3_SECRET_ACCESS_KEY=collog-minio-secret

# Track Egress worker 없이 기기 분석용 PCM만으로 파이프라인을 돌린다. 개발 전용.
ALLOW_RAW_ONLY_ANALYSIS=false

# STT 발화 텍스트를 서버 로그에 남긴다. transcript 원문은 민감정보이므로 개발 전용.
# false여도 provider/발화시간/segment 수 요약은 항상 남는다.
LOG_STT_TRANSCRIPT=false
